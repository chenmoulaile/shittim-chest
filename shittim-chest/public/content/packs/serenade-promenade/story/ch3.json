    { "type": "say", "char": "noise", "text": "吼——！主舞台是我们的！我们要连开七场演唱会——！" },
    { "type": "enter", "char": "mine", "position": "left" },
    { "type": "say", "char": "mine", "text": "七场？！连唱七场的话，音响设备会烧掉的吧！" },
    { "type": "enter", "char": "sakurako", "position": "center" },
